{
  "name": "guoyou-cv",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts resume/verify/verify.js",
    "build:cv": "node scripts/render-cv.mjs",
    "verify:cv": "node scripts/verify-cv.mjs",
    "test:cv": "node --test scripts/test-cv-*.mjs"
  },
  "devDependencies": {
    "marked": "18.1.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1"
  }
}
